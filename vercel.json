{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node --test tests/vercel-config.test.mjs",
  "outputDirectory": "public",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/", "destination": "/reference.html" },
    { "source": "/work", "destination": "/work-reference.html" },
    { "source": "/info", "destination": "/info-reference.html" },
    { "source": "/contact", "destination": "/contact-reference.html" },
    { "source": "/work/:slug", "destination": "/work-:slug-reference.html" }
  ]
}
